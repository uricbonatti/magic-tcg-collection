PORT=3333
NODE_ENV=development

# MongoDB (use MONGO_URL ou host/porta/usuário/senha)
MONGO_URL=mongodb://localhost:27017
# MONGO_HOST=localhost
# MONGO_PORT=27017
# MONGO_USERNAME=
# MONGO_PASSWORD=

# Segredo para assinar os JWT (obrigatório em produção)
APP_SECRET=troque-este-segredo

# Google Cloud Translation (https://cloud.google.com/translate/docs/setup)
GOOGLE_PROJECT_ID=
GOOGLE_TRANSLATE_API_KEY=
