{
  "name": "magic-tcg-collection",
  "version": "1.1.0",
  "main": "dist/shared/app/server.js",
  "repository": "git@github.com:uricbonatti/magic-tcg-collection.git",
  "author": "Uric Bonatti <uricbonatti.eng@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/shared/app/server.js",
    "start:dev": "ts-node-dev -r tsconfig-paths/register -r dotenv/config --transpile-only --ignore-watch node_modules src/shared/app/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "jest --selectProjects unit",
    "test:e2e": "jest --selectProjects e2e --runInBand",
    "test:all": "npm test && npm run test:e2e",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@google-cloud/translate": "^10.2.0",
    "bcryptjs": "^3.0.3",
    "celebrate": "^15.0.3",
    "class-transformer": "^0.5.1",
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "express-async-errors": "^3.1.1",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^6.21.0",
    "reflect-metadata": "^0.2.2",
    "remove-accents": "^0.5.0",
    "replace-special-characters": "^1.2.7",
    "tsyringe": "^4.10.0",
    "typeorm": "^0.3.31",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testcontainers/mongodb": "^11.14.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/supertest": "^6.0.3",
    "dotenv": "^16.6.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "mock-express-request": "^0.2.2",
    "mock-express-response": "^0.3.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "testcontainers": "^11.14.0",
    "ts-jest": "^29.4.14",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.9.7",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
